{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "job_possibility.schema.json",
  "title": "Job possibility scores (job_possibility.json)",
  "type": "object",
  "additionalProperties": true,
  "required": ["meta", "organizations"],
  "properties": {
    "meta": { "type": "object" },
    "organizations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "name", "possibility", "score"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "possibility": { "type": "string" },
          "score": { "type": ["integer", "null"] }
        }
      }
    },
    "unresearchedNote": { "type": "object" }
  }
}
