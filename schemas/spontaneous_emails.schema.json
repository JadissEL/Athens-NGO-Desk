{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spontaneous_emails.schema.json",
  "title": "Spontaneous candidature contacts (spontaneous_emails.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "contacts"],
  "properties": {
    "meta": { "type": "object", "additionalProperties": true },
    "contacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "note"],
        "properties": {
          "orgId": { "type": ["string", "null"] },
          "name": { "type": "string", "minLength": 1 },
          "email": { "type": ["string", "null"] },
          "applyUrl": { "type": ["string", "null"], "format": "uri" },
          "kind": { "type": "string" },
          "note": { "type": "string" }
        },
        "anyOf": [
          {
            "properties": { "email": { "type": "string", "minLength": 1 } },
            "required": ["email"]
          },
          {
            "properties": {
              "applyUrl": { "type": "string", "minLength": 1, "format": "uri" }
            },
            "required": ["applyUrl"]
          }
        ]
      }
    }
  }
}
