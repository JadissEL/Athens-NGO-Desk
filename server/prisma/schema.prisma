generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Single-row draft workspace for stewards (JSON mirrors window.NGO_DATA keys).
model DraftBundle {
  id           Int      @id @default(1)
  registry     Json
  possibility  Json
  summary      Json
  emails       Json
  media        Json
  updatedAt    DateTime @updatedAt
}

/// Single-row published snapshot served by GET /api/ngo-data
model PublishedBundle {
  id           Int      @id @default(1)
  registry     Json
  possibility  Json
  summary      Json
  emails       Json
  media        Json
  publishedAt  DateTime
}

/// Append-only audit trail for steward actions and publishes
model AuditLog {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now())
  actorKey   String
  action     String
  entityType String?
  entityId   String?
  detail     Json?
}
