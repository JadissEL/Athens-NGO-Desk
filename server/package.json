{
  "name": "athens-ngo-desk-server",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Phase B API — Fastify + Prisma + PostgreSQL for NGO_DATA bundle",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "prisma generate && tsc",
    "typecheck": "prisma generate && tsc --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx scripts/seed_from_json.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.27.0",
    "@fastify/cors": "^10.0.2",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.10",
    "@prisma/client": "^6.3.1",
    "fastify": "^5.2.1",
    "jose": "^6.2.15",
    "jsonwebtoken": "^9.0.3",
    "prisma": "^6.3.1"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
