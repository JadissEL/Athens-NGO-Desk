# PostgreSQL (EU region recommended in production)
DATABASE_URL="postgresql://user:pass@localhost:5432/athens_ngo_desk?schema=public"

# --- Clerk (recommended for steward sign-in) ---
# Server: verify Clerk session JWTs on steward routes (use secret key from https://dashboard.clerk.com → API keys)
CLERK_SECRET_KEY=""
# Optional networkless verify: PEM public key from Dashboard → JWT public key
# CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----..."
# Browser (steward UI loads this via GET /api/steward-config — safe to expose)
CLERK_PUBLISHABLE_KEY=""
# Comma-separated origins allowed to mint session tokens (must include steward URL, e.g. http://127.0.0.1:4000 )
# CLERK_AUTHORIZED_PARTIES="http://127.0.0.1:4000,https://api.example.com"
# Optional stewardship gate: require role in public_metadata (path override below)
# CLERK_STEWARD_REQUIRED_ROLE="steward"
# CLERK_STEWARD_ROLE_METADATA_PATH="public_metadata.role"

# Comma-separated steward keys (rotate regularly). Break-glass only when using Clerk.
STEWARD_API_KEYS="dev-key-change-me"

# Optional — Bearer JWT instead of raw API key (choose one path):
# JWKS (Entra ID / Clerk / OIDC): set URL; optional issuer + audience
# STEWARD_JWKS_URL="https://example.okta.com/oauth2/default/v1/keys"
# STEWARD_JWT_ISSUER="https://example.okta.com/oauth2/default"
# STEWARD_JWT_AUDIENCE="api://greece-ngo-desk"
# STEWARD_JWT_ROLE_CLAIM="role"
# STEWARD_JWT_REQUIRED_ROLE="steward"

# Or HS256 with shared secret (dev only):
# STEWARD_JWT_SECRET="change-me"

# Allowed origin for steward UI (browser). Use * only in local dev.
CORS_ORIGIN="http://127.0.0.1:4000"

# Rate limit for public GET /api/ngo-data (default 300 req / 1 minute per IP)
# RATE_LIMIT_PUBLIC_MAX=300
# RATE_LIMIT_PUBLIC_WINDOW_MS=60000

PORT=4000
HOST=0.0.0.0

# Hospitality lane — CV uploads (local disk by default; use object storage path in production)
# HOSPITALITY_CV_UPLOAD_DIR="/var/lib/ngo-desk/hospitality-cv"

# Civic event scrape (broad adapters — legal review required)
# ENABLE_EVENTBRITE_SCRAPE=1
# EVENTBRITE_API_TOKEN=""
# ENABLE_FACEBOOK_SCRAPE=1
# FACEBOOK_GRAPH_TOKEN=""
# RATE_LIMIT_MESSAGE_MAX=60

# Stricter rate limit for applications + CV upload (default 30 / minute per IP)
# RATE_LIMIT_APPLY_MAX=30
# RATE_LIMIT_APPLY_WINDOW_MS=60000
