{
  "name": "greece-ngo-desk",
  "private": true,
  "description": "Greece NGO Desk — static site with JSON-backed registry and build scripts",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build:data": "node scripts/build_data.js",
    "merge:jobs": "node scripts/merge_ngo_job_research.js",
    "validate": "node scripts/validate_data_schemas.js",
    "validate:schemas": "node scripts/validate_data_schemas.js",
    "validate:seed": "node scripts/validate_job_research_seed.js",
    "validate:import": "node scripts/validate_registry_import.js",
    "export:api": "node scripts/export_from_api.js",
    "smoke:api": "node scripts/smoke_api.js",
    "audit:registry-duplicates": "node scripts/audit_registry_duplicates.js",
    "import:registry": "node scripts/import_registry_rows.js",
    "national:wave:status": "node scripts/national/wave_status.mjs",
    "national:wave1:apply": "node scripts/national/apply_wave1_imports.mjs",
    "national:wave2:patch": "node scripts/national/patch_profiles.mjs",
    "national:wave3:merge-jobs": "node scripts/national/merge_job_research_waves.mjs",
    "osint:coverage": "node scripts/report_osint_coverage.js",
    "test:e2e:static": "playwright test",
    "test:e2e:static:ui": "playwright test --ui"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0"
  }
}
